{
  "name": "dsh-session-booth",
  "type": "module",
  "version": "0.3.7",
  "main": "./index.js",
  "description": "Session Booth: a persistent multi-session split view in the DSH main window.",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "FdcWinPC",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "split-view",
    "multi-session",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FdcWinPC/dsh-session-booth.git"
  },
  "homepage": "https://github.com/FdcWinPC/dsh-session-booth#readme",
  "bugs": {
    "url": "https://github.com/FdcWinPC/dsh-session-booth/issues"
  },
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./src/locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "pack": "npm pack --dry-run"
  }
}
